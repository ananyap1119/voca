{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "voca",
  "version": "0.2.0",
  "identifier": "com.ananyap1119.voca",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "voca",
        "url": "index.html",
        "visible": true,
        "width": 1200,
        "height": 800,
        "resizable": false,
        "decorations": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
